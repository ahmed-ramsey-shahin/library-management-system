{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "BorrowSettings": {
        "MaxActiveBorrows": 5,
        "MaxLateBorrows": 2,
        "MaxUnpaidFines": 1,
        "MaxRenewalCount": 3
    },
    "JwtSettings": {
        "TokenExpirationInMinutes": 15,
        "Issuer": "localhost",
        "Audience": "localhost"
    },
    "AppSettings": {
        "LocalCacheExpirationInMins": 5,
        "DistributedCacheExpirationMins": 5,
        "DefaultPageNumber": 1,
        "DefaultPageSize": 10,
        "CorsPolicyName": "lms",
        "AllowedOrigins": [ "http://localhost:5099", "https://localhost:7258" ]
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.Seq"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Information"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://seq:5341"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ],
        "Properties": {
            "Application": "api"
        }
    },
    "EmailService":
    {
        "SenderEmail": "ahmed.ramsey.shahin@gmail.com",
        "SenderName": "LMS"
    },
    "AllowedHosts": "*"
}
